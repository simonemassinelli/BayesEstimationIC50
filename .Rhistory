cat("\n========================================================\n")
cat("ADVANCED HIERARCHICAL VISUALIZATIONS\n")
cat("========================================================\n")
# ==============================================================================
# 1. SHRINKAGE PLOT (Pooling of Information)
# ==============================================================================
# Estraiamo le stime medie a posteriori per tutti i pazienti dal modello JAGS
bayes_summary <- fit_patient$BUGSoutput$summary
ic50_rows <- grep("^IC50\\[", rownames(bayes_summary))
bayes_ic50_means <- bayes_summary[ic50_rows, "mean"]
# Creiamo un dataset unendo le stime Frequentiste e quelle Bayesiane
df_shrinkage <- fixed_params %>%
mutate(
Bayesian_IC50 = bayes_ic50_means[patient_idx],
Frequentist_IC50 = ic50_frequentist
) %>%
# Rimuoviamo eventuali NA o stime esplose frequentiste per pulizia visiva
filter(!is.na(Frequentist_IC50) & Frequentist_IC50 < max(Bayesian_IC50) * 3)
# Calcoliamo la media globale per tracciare la linea di riferimento
global_mean_ic50 <- mean(df_shrinkage$Bayesian_IC50)
# Creazione del grafico di Shrinkage
plot_shrinkage <- ggplot(df_shrinkage) +
# Linea della media globale
geom_vline(xintercept = global_mean_ic50, linetype = "dashed", color = "darkred", alpha = 0.6, linewidth = 1) +
# Frecce che collegano le stime (da Frequentista a Bayesiana)
geom_segment(aes(x = Frequentist_IC50, xend = Bayesian_IC50,
y = reorder(patient_id, Bayesian_IC50), yend = reorder(patient_id, Bayesian_IC50)),
arrow = arrow(length = unit(0.15, "cm"), type = "closed"), color = "grey60") +
# Pallini delle stime Frequentiste
geom_point(aes(x = Frequentist_IC50, y = reorder(patient_id, Bayesian_IC50), color = "Frequentist"), size = 2.5, alpha = 0.8) +
# Pallini delle stime Bayesiane
geom_point(aes(x = Bayesian_IC50, y = reorder(patient_id, Bayesian_IC50), color = "Bayesian"), size = 2.5) +
scale_color_manual(name = "Estimation Method", values = c("Frequentist" = "#e76f51", "Bayesian" = "#2a9d8f")) +
theme_minimal() +
theme(
legend.position = "top",
axis.text.y = element_text(size = 7),
plot.title = element_text(face = "bold")
) +
labs(
title = "Hierarchical Shrinkage Effect",
subtitle = "Arrows show isolated extreme estimates being pulled toward the global mean",
x = "IC50 Estimate",
y = "Patient ID"
)
print(plot_shrinkage)
