theme_classic() +
theme(
legend.position = "top",
plot.title = element_text(face = "bold")
) +
labs(
title = paste("Posterior Predictive Dose-Response:", target_patient),
subtitle = "The credible band reflects the exact MCMC uncertainty around the non-linear fit",
x = "Dose (Log Scale)",
y = "Cell Viability"
)
